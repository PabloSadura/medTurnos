rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------
    // Shared Primitives
    // ------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isStaffOf(userId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.userId == userId;
    }

    function canAccessData(userId) {
      return isOwner(userId) || isStaffOf(userId);
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------
    // Collections
    // ------------------------------------------------------------

    match /appointments/{id} {
      allow read, write: if isSignedIn() && canAccessData(resource.data.userId);
      allow create: if isSignedIn() && canAccessData(request.resource.data.userId);
    }

    match /patients/{id} {
      allow read, write: if isSignedIn() && canAccessData(resource.data.userId);
      allow create: if isSignedIn() && canAccessData(request.resource.data.userId);
      
      match /evolutions/{eid} {
        allow read, write: if isSignedIn() && canAccessData(resource.data.userId);
        allow create: if isSignedIn() && canAccessData(request.resource.data.userId);
      }
    }

    match /treatments/{id} {
      allow read, write: if isSignedIn() && canAccessData(resource.data.userId);
      allow create: if isSignedIn() && canAccessData(request.resource.data.userId);
    }

    match /stocks/{id} {
      allow read, write: if isSignedIn() && canAccessData(resource.data.userId);
      allow create: if isSignedIn() && canAccessData(request.resource.data.userId);
      
      match /movements/{mid} {
        allow read, write: if isSignedIn() && canAccessData(resource.data.userId);
        allow create: if isSignedIn() && canAccessData(request.resource.data.userId);
      }
    }

    match /users/{id} {
      allow read: if isSignedIn() && (id == request.auth.uid || isStaffOf(id) || isAdmin());
      allow write: if isSignedIn() && (
        id == request.auth.uid || 
        (exists(/databases/$(database)/documents/staff/$(id)) && get(/databases/$(database)/documents/staff/$(id)).data.userId == request.auth.uid) ||
        isAdmin()
      );
    }

    match /staff/{id} {
      // Allow user to read their own staff doc, or the owner to read all their staff
      allow read: if isSignedIn() && (id == request.auth.uid || (resource != null && resource.data.userId == request.auth.uid));
      // Allow listing: Owner can list all their staff, staff can list themselves
      allow list: if isSignedIn(); 
      allow write: if isSignedIn() && (
        request.auth.uid == id || 
        (request.resource != null && request.resource.data.userId == request.auth.uid) || 
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    match /whatsapp_logs/{id} {
      allow read: if isSignedIn() && canAccessData(resource.data.userId);
      allow create: if isSignedIn() && canAccessData(request.resource.data.userId);
    }

    match /reminder_settings/{id} {
      allow read, write: if isSignedIn() && (id == request.auth.uid || isStaffOf(id));
    }
  }
}
