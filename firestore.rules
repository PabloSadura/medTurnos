rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------
    // Shared Primitives
    // ------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@mail.com' ||
        request.auth.token.email == 'pablosadura@gmail.com' ||
        request.auth.uid == 'tFHvaQo649hwrlQfisr2x8qlv8v2' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isStaffOf(userId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.userId == userId;
    }

    function canAccessData(userId) {
      return isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        isStaffOf(userId)
      );
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------
    // Collections
    // ------------------------------------------------------------

    match /plans/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /appointments/{id} {
      allow read, write: if isSignedIn() && (canAccessData(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && (canAccessData(request.resource.data.userId) || isAdmin());
    }

    match /patients/{id} {
      allow read, write: if isSignedIn() && (canAccessData(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && (canAccessData(request.resource.data.userId) || isAdmin());
      
      match /evolutions/{eid} {
        allow read, write: if isSignedIn() && (canAccessData(resource.data.userId) || isAdmin());
        allow create: if isSignedIn() && (canAccessData(request.resource.data.userId) || isAdmin());
      }
    }

    match /treatments/{id} {
      allow read, write: if isSignedIn() && (canAccessData(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && (canAccessData(request.resource.data.userId) || isAdmin());
    }

    match /stocks/{id} {
      allow read, write: if isSignedIn() && (canAccessData(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && (canAccessData(request.resource.data.userId) || isAdmin());
      
      match /movements/{mid} {
        allow read, write: if isSignedIn() && (canAccessData(resource.data.userId) || isAdmin());
        allow create: if isSignedIn() && (canAccessData(request.resource.data.userId) || isAdmin());
      }
    }

    match /users/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (id == request.auth.uid || isAdmin());
    }

    match /staff/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        request.auth.uid == id || 
        (request.resource != null && request.resource.data.userId == request.auth.uid) || 
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
    }

    match /whatsapp_logs/{id} {
      allow read: if isSignedIn() && (canAccessData(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && (canAccessData(request.resource.data.userId) || isAdmin());
      allow write: if isSignedIn() && (canAccessData(resource.data.userId) || isAdmin());
    }

    match /reminder_settings/{id} {
      allow read, write: if isSignedIn() && (id == request.auth.uid || isAdmin() || isStaffOf(id));
    }
  }
}

