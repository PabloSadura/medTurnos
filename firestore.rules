rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------
    // Shared Primitives
    // ------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && (
          request.auth.token.email == 'admin@mail.com' ||
          request.auth.token.email == 'pablosadura@gmail.com'
        )) ||
        request.auth.uid == 'tFHvaQo649hwrlQfisr2x8qlv8v2' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    function isStaffOf(userId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/staff/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('userId', '') == userId;
    }

    function canAccessData(userId) {
      return isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        isStaffOf(userId)
      );
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------
    // Collections
    // ------------------------------------------------------------

    match /test/{id} {
      allow read: if true;
    }

    match /plans/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /appointments/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || canAccessData(request.resource.data.userId) || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
    }

    match /patients/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || canAccessData(request.resource.data.userId) || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
      
      match /evolutions/{eid} {
        allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
        allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || canAccessData(request.resource.data.userId) || isAdmin());
        allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
      }
    }

    match /evolutions/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || canAccessData(request.resource.data.userId) || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
    }

    match /{path=**}/evolutions/{eid} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || canAccessData(request.resource.data.userId) || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
    }

    match /treatments/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || canAccessData(request.resource.data.userId) || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
    }

    match /packages/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || canAccessData(request.resource.data.userId) || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
    }

    match /patient_packages/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || canAccessData(request.resource.data.userId) || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
    }

    match /patient_photos/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || canAccessData(request.resource.data.userId) || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
    }

    match /stocks/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || canAccessData(request.resource.data.userId) || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
      
      match /movements/{mid} {
        allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
        allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || canAccessData(request.resource.data.userId) || isAdmin());
        allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
      }
    }

    match /users/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (id == request.auth.uid || isAdmin());
    }

    match /profiles/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (id == request.auth.uid || isAdmin());
    }

    match /staff/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.auth.uid == id || 
        ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid) || 
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        request.auth.uid == id || 
        ('userId' in resource.data && resource.data.userId == request.auth.uid) || 
        isAdmin()
      );
    }

    match /whatsapp_logs/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || canAccessData(request.resource.data.userId) || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || canAccessData(resource.data.userId) || isAdmin());
    }

    match /reminder_settings/{id} {
      allow read: if isSignedIn() && (
        id == request.auth.uid || 
        canAccessData(id) || 
        isAdmin() || 
        (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId))
      );
      allow create, update, delete: if isSignedIn() && (
        id == request.auth.uid || 
        canAccessData(id) || 
        isAdmin() || 
        (request.resource != null && 'userId' in request.resource.data && canAccessData(request.resource.data.userId))
      );
    }
  }
}
