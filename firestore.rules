rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------
    // Shared Security Primitives (Server-side Verifiable)
    // ------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Role-based Access Control via trusted database document (users/{uid})
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // Check if the current authenticated user is an authorized staff member for the target doctor
    function isStaffOf(userId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('userId', '') == userId &&
         get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('status', 'Activo') == 'Activo') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userId', '') == userId &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'Activo') == 'Activo')
      );
    }

    // Access to clinical and administrative data scoped to doctor, their staff, or verified admin
    function canAccessData(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        isStaffOf(userId) ||
        isAdmin()
      );
    }

    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------
    // System Catalog & Plans (Authenticated Read, Admin Write)
    // ------------------------------------------------------------
    match /plans/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /system_stats/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /referrals/{id} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource != null && (
          resource.data.get('referrerId', '') == request.auth.uid ||
          resource.data.get('referredUserId', '') == request.auth.uid
        ))
      );
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------
    // User Profiles & Staff Management
    // ------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isStaffOf(userId) ||
        isAdmin()
      );
      // New users can create their own profile with 'medico' role (not admin)
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.get('role', 'medico') != 'admin';
      // Existing users can update their profile but cannot escalate role or bypass payment status
      allow update: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == userId &&
          request.resource.data.get('role', resource.data.get('role', 'medico')) == resource.data.get('role', 'medico') &&
          request.resource.data.get('paymentStatus', resource.data.get('paymentStatus', 'al_dia')) == resource.data.get('paymentStatus', 'al_dia') &&
          request.resource.data.get('isBlocked', resource.data.get('isBlocked', false)) == resource.data.get('isBlocked', false)
        )
      );
      allow delete: if isAdmin();
    }

    match /profiles/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isStaffOf(userId) ||
        isAdmin()
      );
      allow write: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin()
      );
    }

    match /staff/{staffId} {
      allow read: if isSignedIn() && (
        request.auth.uid == staffId ||
        isAdmin() ||
        (resource != null && (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('authUid', '') == request.auth.uid
        ))
      );
      allow write: if isSignedIn() && (
        isAdmin() ||
        (request.resource != null && request.resource.data.get('userId', '') == request.auth.uid) ||
        (resource != null && resource.data.get('userId', '') == request.auth.uid)
      );
    }

    // ------------------------------------------------------------
    // Clinical Collections (Scoped to Practitioner, Staff or Admin)
    // ------------------------------------------------------------
    match /appointments/{id} {
      allow read: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
      allow create: if isSignedIn() && (isAdmin() || (request.resource != null && 'userId' in request.resource.data && canAccessData(request.resource.data.userId)));
      allow update: if isSignedIn() && (
        isAdmin() || (
          resource != null && 'userId' in resource.data && canAccessData(resource.data.userId) &&
          // Finished appointments cannot revert to a previous status
          (
            !(resource.data.get('status', '') in ['finished', 'finalizado']) ||
            (request.resource.data.get('status', '') in ['finished', 'finalizado'])
          )
        )
      );
      allow delete: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
    }

    match /patients/{id} {
      allow read: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
      allow create: if isSignedIn() && (isAdmin() || (request.resource != null && 'userId' in request.resource.data && canAccessData(request.resource.data.userId)));
      allow update, delete: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));

      match /evolutions/{eid} {
        allow read: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
        allow create: if isSignedIn() && (isAdmin() || (request.resource != null && 'userId' in request.resource.data && canAccessData(request.resource.data.userId)));
        allow update, delete: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
      }
    }

    match /evolutions/{id} {
      allow read: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
      allow create: if isSignedIn() && (isAdmin() || (request.resource != null && 'userId' in request.resource.data && canAccessData(request.resource.data.userId)));
      allow update, delete: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
    }

    match /{path=**}/evolutions/{eid} {
      allow read: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
      allow create: if isSignedIn() && (isAdmin() || (request.resource != null && 'userId' in request.resource.data && canAccessData(request.resource.data.userId)));
      allow update, delete: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
    }

    match /treatments/{id} {
      allow read: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
      allow create: if isSignedIn() && (isAdmin() || (request.resource != null && 'userId' in request.resource.data && canAccessData(request.resource.data.userId)));
      allow update, delete: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
    }

    match /packages/{id} {
      allow read: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
      allow create: if isSignedIn() && (isAdmin() || (request.resource != null && 'userId' in request.resource.data && canAccessData(request.resource.data.userId)));
      allow update, delete: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
    }

    match /patient_packages/{id} {
      allow read: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
      allow create: if isSignedIn() && (isAdmin() || (request.resource != null && 'userId' in request.resource.data && canAccessData(request.resource.data.userId)));
      allow update, delete: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
    }

    match /patient_photos/{id} {
      allow read: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
      allow create: if isSignedIn() && (isAdmin() || (request.resource != null && 'userId' in request.resource.data && canAccessData(request.resource.data.userId)));
      allow update, delete: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
    }

    match /stocks/{id} {
      allow read: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
      allow create: if isSignedIn() && (isAdmin() || (request.resource != null && 'userId' in request.resource.data && canAccessData(request.resource.data.userId)));
      allow update, delete: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));

      match /movements/{mid} {
        allow read: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
        allow create: if isSignedIn() && (isAdmin() || (request.resource != null && 'userId' in request.resource.data && canAccessData(request.resource.data.userId)));
        allow update, delete: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
      }
    }

    match /whatsapp_logs/{id} {
      allow read: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
      allow create: if isSignedIn() && (isAdmin() || (request.resource != null && 'userId' in request.resource.data && canAccessData(request.resource.data.userId)));
      allow update, delete: if isSignedIn() && (isAdmin() || (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId)));
    }

    match /reminder_settings/{id} {
      allow read: if isSignedIn() && (
        id == request.auth.uid ||
        canAccessData(id) ||
        (resource != null && 'userId' in resource.data && canAccessData(resource.data.userId))
      );
      allow create, update, delete: if isSignedIn() && (
        id == request.auth.uid ||
        canAccessData(id) ||
        (request.resource != null && 'userId' in request.resource.data && canAccessData(request.resource.data.userId))
      );
    }

    // ------------------------------------------------------------
    // Audit Logs (Immutable Security and Administrative Audit Trail)
    // ------------------------------------------------------------
    match /audit_logs/{id} {
      allow read: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && (
        isAdmin() || (request.resource != null && request.resource.data.get('authorId', '') == request.auth.uid)
      );
      allow update, delete: if false; // Append-only audit logs
    }
  }
}
